DISCORD_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=your-application-id-here

# Optional - if set, commands register instantly to this one server instead
# of globally (global registration can take up to an hour to show up)
DISCORD_GUILD_ID=

# Optional access control - comma-separated Discord IDs.
# Leave both blank to allow anyone in the server to use /build.
ALLOWED_USER_IDS=
ALLOWED_ROLE_IDS=

# Optional - comma-separated Discord user IDs who can use /config and see
# bot-wide /stats instead of just their own.
ADMIN_USER_IDS=

# Optional tuning
MAX_CONCURRENT_BUILDS=1
PER_USER_COOLDOWN_MS=15000
BUILD_CACHE_DIR=
BUILD_TIMEOUT_MS=300000
MAVEN_THREADS=1C
MAX_ZIP_BYTES=26214400
MAX_JAR_BYTES=8589934592
INLINE_LOG_LIMIT=1500

# Where build history (sqlite) is stored. Mount a volume here in prod.
DATA_DIR=./data

# development = pretty colored console logs, production = JSON lines
NODE_ENV=development
LOG_LEVEL=info
